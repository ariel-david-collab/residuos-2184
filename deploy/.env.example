# ═══════════════════════════════════════════════════════════
# .env de producción — Residuos 2184
# ═══════════════════════════════════════════════════════════
# El archivo real NO se commitea ni se edita en el VPS: OpenBao lo
# materializa en /home/morfeo/residuos/.env desde
# secret/residuos/prod (KV v2, campo `content`).
#
# La app no maneja credenciales (modelo público, sin base de datos ni
# login). Este .env centraliza la configuración de despliegue; si más
# adelante aparece una clave real, va en el mismo path de OpenBao.
# ═══════════════════════════════════════════════════════════

# Dominio público. Traefik lo usa en la regla Host() y el wrapper en el
# health check. Sin `https://`, sin barra final, sin comillas.
DOMINIO=residuos.tudominio.com

# Zona horaria del contenedor.
TZ=America/Bogota
